#!/usr/bin/env python3
"""Launcher that works from a source checkout as well as an install."""
import os
import sys
from pathlib import Path

# When run straight out of a git clone, put the tree on sys.path.
_root = Path(__file__).resolve().parent.parent
if (_root / "gdrive_client" / "__init__.py").exists():
    sys.path.insert(0, str(_root))

from gdrive_client.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
